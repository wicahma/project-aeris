---
import DocsLayout from '../../components/templates/DocsLayout.astro';
import { CodeBlock } from '../../components/atoms/CodeBlock';
import { Badge } from '../../components/atoms/Badge';
import { Button } from '../../components/atoms/Button';
import { Terminal, Download, ArrowLeft, Clock, ShieldCheck } from 'lucide-react';
---

<DocsLayout
  title="Installation Guide — Project Aeris Documentation"
  description="Step-by-step installation instructions for Project Aeris via Shell Script, Homebrew, APT, and Windows Winget."
  currentPath="/docs/installation"
>
  <article className="space-y-10 font-sans">
    <div className="space-y-3 border-b border-zinc-800 pb-6">
      <div className="flex items-center gap-2">
        <Badge variant="indigo">Getting Started</Badge>
        <Badge variant="emerald">Installation</Badge>
      </div>
      <h1 className="text-4xl font-black text-white tracking-tight">Installation Guide</h1>
      <p className="text-dark-muted text-base leading-relaxed">
        Choose your preferred distribution channel to install Project Aeris on Linux, macOS, or Windows.
      </p>
    </div>

    <section id="shell-installer" className="space-y-4">
      <div className="flex items-center justify-between">
        <h2 className="text-xl font-bold font-mono text-white flex items-center gap-2">
          <Terminal className="w-5 h-5 text-brand-primary" />
          <span>1. Shortened Shell Installer (Recommended)</span>
        </h2>
        <Badge variant="emerald">Linux / macOS</Badge>
      </div>
      <p className="text-xs text-zinc-300">
        Automated bash script that auto-detects architecture (amd64/arm64), verifies SHA256 checksum, installs binary to <code className="text-brand-accent font-mono">/usr/local/bin/aeris</code>, and sets up systemd.
      </p>
      <CodeBlock code="curl -fsSL https://get.diama.dev/dbms.sh | sh" language="bash" client:load />
    </section>

    <section id="homebrew" className="space-y-4 border-t border-zinc-800 pt-6">
      <div className="flex items-center justify-between">
        <h2 className="text-xl font-bold font-mono text-white flex items-center gap-2">
          <Download className="w-5 h-5 text-brand-accent" />
          <span>2. Homebrew Tap (macOS & Linux)</span>
        </h2>
        <Badge variant="indigo">Homebrew</Badge>
      </div>
      <p className="text-xs text-zinc-300">Official Homebrew Tap formula for Apple Silicon & Intel macOS.</p>
      <CodeBlock code="brew install wicahma/tap/dbms" language="bash" client:load />
    </section>

    <section id="apt-repo" className="space-y-4 border-t border-zinc-800 pt-6">
      <div className="flex items-center justify-between">
        <h2 className="text-xl font-bold font-mono text-white flex items-center gap-2">
          <ShieldCheck className="w-5 h-5 text-brand-primary" />
          <span>3. Debian/Ubuntu APT Repository</span>
        </h2>
        <Badge variant="amber">APT / .deb</Badge>
      </div>
      <p className="text-xs text-zinc-300">Official APT repository with GPG package signing and native systemd service integration.</p>
      <CodeBlock code={`# Add GPG Key
curl -fsSL https://apt.diama.dev/gpg.key | sudo gpg --dearmor -o /etc/apt/trusted.gpg.d/dbms.gpg

# Add APT Repository & Install
echo "deb [signed-by=/etc/apt/trusted.gpg.d/dbms.gpg] https://apt.diama.dev/ stable main" | sudo tee /etc/apt/sources.list.d/dbms.list
sudo apt update && sudo apt install dbms`} language="bash" client:load />
    </section>

    <section id="windows" className="space-y-4 border-t border-zinc-800 pt-6">
      <div className="flex items-center justify-between">
        <h2 className="text-xl font-bold font-mono text-white flex items-center gap-2">
          <Terminal className="w-5 h-5 text-brand-accent" />
          <span>4. Windows Winget & Chocolatey</span>
        </h2>
        <Badge variant="zinc">Windows</Badge>
      </div>
      <p className="text-xs text-zinc-300">Install via Windows Package Manager or Chocolatey Gallery.</p>
      <CodeBlock code="winget install wicahma.dbms" language="powershell" client:load />
    </section>

    <section className="bg-zinc-900/80 border border-zinc-800 rounded-lg p-6 space-y-3 font-mono text-xs text-zinc-400">
      <div className="flex items-center gap-2 font-bold text-amber-400">
        <Clock className="w-4 h-4" />
        <span>To Be Continued...</span>
      </div>
      <p className="text-zinc-300">
        Advanced configuration options, custom build flags, Docker containers, and Offline Air-Gapped installation guides will be detailed in upcoming releases.
      </p>
    </section>

    <div className="pt-6 border-t border-zinc-800 flex justify-between">
      <Button href="/docs/introduction" variant="outline" size="md" className="gap-2">
        <ArrowLeft className="w-4 h-4" />
        <span>Back: Introduction</span>
      </Button>
    </div>
  </article>
</DocsLayout>