---
import DocsLayout from '../../components/templates/DocsLayout.astro';
import { CodeBlock } from '../../components/atoms/CodeBlock';
import { Badge } from '../../components/atoms/Badge';
import { Button } from '../../components/atoms/Button';
import { ArrowRight, Cpu, Layers, Zap, Shield, Database } from 'lucide-react';
---

<DocsLayout
  title="Introduction — Project Aeris Documentation"
  description="Learn about Project Aeris: A lightweight single-binary DBMS with an embedded web IDE and auto-generated APIs."
  currentPath="/docs/introduction"
>
  <article class="space-y-8 font-sans">
    <div className="space-y-3 border-b border-zinc-800 pb-6">
      <div className="flex items-center gap-2">
        <Badge variant="indigo">Getting Started</Badge>
        <Badge variant="emerald">Overview</Badge>
      </div>
      <h1 className="text-4xl font-black text-white tracking-tight">Introduction to Project Aeris</h1>
      <p className="text-dark-muted text-base leading-relaxed">
        Project Aeris is a lightweight, single-binary Database Management System (DBMS) designed for high-performance engineering, local homelabs, and edge deployments.
      </p>
    </div>

    <section className="space-y-4">
      <h2 className="text-2xl font-bold font-mono text-white flex items-center gap-2">
        <Database className="w-6 h-6 text-brand-primary" />
        <span>What is Project Aeris?</span>
      </h2>
      <p className="text-zinc-300 text-sm leading-relaxed">
        Traditional database management systems often require heavy external dependencies, complex container setups, or bulky Electron-based desktop clients. Project Aeris eliminates this complexity by packaging a high-throughput SQL engine, an embedded CodeMirror 6 Web IDE, and auto-generated REST/GraphQL APIs into a <strong>single, zero-dependency executable</strong> under 20MB.
      </p>
    </section>

    <section className="space-y-4 border-t border-zinc-800 pt-6">
      <h2 className="text-2xl font-bold font-mono text-white flex items-center gap-2">
        <Cpu className="w-6 h-6 text-brand-accent" />
        <span>Core Architectural Pillars</span>
      </h2>

      <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div className="bg-dark-card border border-zinc-800 rounded-lg p-4 space-y-2">
          <div className="font-mono font-bold text-sm text-white flex items-center gap-2">
            <Zap className="w-4 h-4 text-brand-accent" />
            <span>1. Single Binary Packaging</span>
          </div>
          <p className="text-xs text-dark-muted">
            Compiled with Go 1.22+ and <code className="text-brand-primary">//go:embed</code>. The entire React Vite frontend is bundled directly inside the compiled Go binary.
          </p>
        </div>

        <div className="bg-dark-card border border-zinc-800 rounded-lg p-4 space-y-2">
          <div className="font-mono font-bold text-sm text-white flex items-center gap-2">
            <Layers className="w-4 h-4 text-brand-primary" />
            <span>2. Embedded Web Console</span>
          </div>
          <p className="text-xs text-dark-muted">
            Instant browser access on startup. Features CodeMirror 6 SQL autocomplete, resizable split panes, and TanStack virtual data grid.
          </p>
        </div>

        <div className="bg-dark-card border border-zinc-800 rounded-lg p-4 space-y-2">
          <div className="font-mono font-bold text-sm text-white flex items-center gap-2">
            <Shield className="w-4 h-4 text-brand-accent" />
            <span>3. Modular SQLite Storage</span>
          </div>
          <p className="text-xs text-dark-muted">
            Pure Go SQLite engine (<code class="text-brand-primary">modernc.org/sqlite</code>) with WAL mode and in-memory mode support. Zero CGO compiler dependencies.
          </p>
        </div>

        <div className="bg-dark-card border border-zinc-800 rounded-lg p-4 space-y-2">
          <div className="font-mono font-bold text-sm text-white flex items-center gap-2">
            <Zap className="w-4 h-4 text-brand-primary" />
            <span>4. Auto-Generated APIs</span>
          </div>
          <p className="text-xs text-dark-muted">
            Automatically generates RESTful and GraphQL CRUD endpoints for every user table, plus async HTTP event webhooks.
          </p>
        </div>
      </div>
    </section>

    <section className="space-y-4 border-t border-zinc-800 pt-6">
      <h2 className="text-2xl font-bold font-mono text-white">Quick Example</h2>
      <p className="text-xs text-zinc-400 font-mono">Launch the server and access the Web IDE immediately:</p>
      <CodeBlock code="aeris serve --port 8080 --data-dir ./data" language="bash" client:load />
    </section>

    <div className="pt-8 border-t border-zinc-800 flex justify-end">
      <Button href="/docs/installation" variant="primary" size="md" className="gap-2">
        <span>Next: Installation Guide</span>
        <ArrowRight className="w-4 h-4" />
      </Button>
    </div>
  </article>
</DocsLayout>