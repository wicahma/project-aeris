---
import { DocsSidebar } from '../organisms/DocsSidebar';
import { DocsSearchModal } from '../organisms/DocsSearchModal';
import { Footer } from '../organisms/Footer';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = 'Documentation : Project Aeris',
  description = 'Official documentation and architecture guide for Project Aeris.',
  currentPath = '/docs/introduction'
} = Astro.props;
---

<!usr/bin/env html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-dark-bg text-zinc-100 font-sans antialiased selection:bg-zinc-800 selection:text-zinc-100">
    <header class="fixed top-0 left-0 right-0 z-40 bg-dark-bg/90 backdrop-blur-md border-b-2 border-zinc-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-4 font-mono font-black text-sm uppercase">
          <a href="/" class="text-white hover:text-indigo-400 transition-colors tracking-wider">
            PROJECT AERIS
          </a>
          <span class="text-zinc-600">/</span>
          <a href="/docs/introduction" class="text-indigo-400 font-bold tracking-wider">DOCS</a>
        </div>

        <div class="flex items-center space-x-4">
          <DocsSearchModal client:load />
          <a href="https://github.com/wicahma/project-aeris" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 font-mono text-xs font-bold uppercase tracking-wider bg-zinc-900 border-2 border-zinc-700 hover:border-indigo-500 text-white transition-colors">
            GitHub
          </a>
        </div>
      </div>
    </header>

    <div class="pt-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex gap-8">
      <div class="hidden md:block py-8 border-r-2 border-zinc-800 pr-6 shrink-0">
        <div class="sticky top-24">
          <DocsSidebar currentPath={currentPath} client:load />
        </div>
      </div>

      <main class="flex-1 py-8 max-w-4xl min-w-0">
        <slot />
      </main>
    </div>

    <Footer client:visible />
  </body>
</html>