---
import { Footer } from '../organisms/Footer';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Project Aeris — Zero-Dependency Drop-in Database',
  description = 'Lightweight, single-binary DBMS with an embedded web IDE and auto-generated APIs. Powered by Go.'
} = Astro.props;
---

<!usr/bin/env html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://aeris.diama.dev/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-dark-bg text-zinc-100 font-sans antialiased selection:bg-indigo-600 selection:text-white">
    <header class="fixed top-0 left-0 right-0 z-50 bg-dark-bg/90 backdrop-blur-md border-b-2 border-zinc-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="font-mono font-black text-lg text-white tracking-wider uppercase">
          PROJECT AERIS
        </a>

        <nav class="hidden md:flex items-center space-x-8 font-mono text-xs uppercase tracking-wider font-bold">
          <a href="#features" class="text-zinc-400 hover:text-white transition-colors">Features</a>
          <a href="#demo" class="text-zinc-400 hover:text-white transition-colors">IDE Console</a>
          <a href="#quickstart" class="text-zinc-400 hover:text-white transition-colors">Quick Start</a>
          <a href="#benchmarks" class="text-zinc-400 hover:text-white transition-colors">Benchmarks</a>
          <a href="/docs/introduction" class="text-indigo-400 hover:text-indigo-300 transition-colors">Docs (/docs)</a>
        </nav>

        <div class="flex items-center space-x-4">
          <a href="https://github.com/wicahma/project-aeris" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 font-mono text-xs font-bold uppercase tracking-wider bg-zinc-900 border-2 border-zinc-700 hover:border-indigo-500 text-white transition-colors">
            GitHub
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <Footer client:visible />
  </body>
</html>